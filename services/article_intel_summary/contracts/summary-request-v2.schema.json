{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newsflux.example/schemas/article-summary-request-v2.json",
  "title": "NewsFlux article summary request v2",
  "description": "Closed identifiers only. The browser never sends prompts, model aliases, article text or URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "model_id", "profile"],
  "properties": {
    "schema_version": { "const": "2" },
    "request_id": { "type": "string", "format": "uuid" },
    "model_id": { "enum": ["s5-free", "mistral-small"] },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "length", "focus", "sections", "language"],
      "properties": {
        "version": { "const": "summary-profile-v1" },
        "length": { "enum": ["brief", "standard", "detailed"] },
        "focus": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "factual_synthesis",
              "key_points",
              "facts_figures",
              "context_implications",
              "actions_next_steps",
              "limitations_open_questions"
            ]
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "contains": { "const": "summary" },
          "items": {
            "enum": ["summary", "key_points", "facts", "implications", "actions", "limitations"]
          }
        },
        "language": { "enum": ["pt-BR", "original"] }
      }
    }
  }
}
