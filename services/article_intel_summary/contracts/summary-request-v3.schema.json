{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newsflux.example/schemas/article-summary-request-v3.json",
  "title": "NewsFlux article summary request v3 (primary + optional fallback)",
  "description": "Closed identifiers only. Primary and optional fallback catalog IDs plus explicit consent flags; never prompts, aliases, article text or URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "primary_model_id",
    "fallback_model_id",
    "fallback_consent",
    "profile"
  ],
  "properties": {
    "schema_version": {
      "const": "3"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "primary_model_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "fallback_model_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fallback_consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paid", "cross_provider"],
      "properties": {
        "paid": {
          "type": "boolean"
        },
        "cross_provider": {
          "type": "boolean"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "length", "focus", "sections", "language"],
      "properties": {
        "version": {
          "const": "summary-profile-v1"
        },
        "length": {
          "enum": ["brief", "standard", "detailed"]
        },
        "focus": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "factual_synthesis",
              "key_points",
              "facts_figures",
              "context_implications",
              "actions_next_steps",
              "limitations_open_questions"
            ]
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "contains": {
            "const": "summary"
          },
          "items": {
            "enum": ["summary", "key_points", "facts", "implications", "actions", "limitations"]
          }
        },
        "language": {
          "enum": ["pt-BR", "original"]
        }
      }
    }
  }
}
