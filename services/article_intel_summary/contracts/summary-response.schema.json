{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newsflux.example/schemas/article-summary-response-v1.json",
  "title": "NewsFlux article summary response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "entry_id",
    "status",
    "content_scope",
    "summary",
    "summary_paragraph_ids",
    "key_points",
    "action_points",
    "limitations",
    "provenance"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "request_id": { "type": "string", "format": "uuid" },
    "entry_id": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 },
    "status": { "enum": ["complete", "partial", "insufficient", "unavailable"] },
    "content_scope": { "enum": ["full", "partial", "unknown"] },
    "summary": { "type": "string", "maxLength": 3000 },
    "summary_paragraph_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^p[1-9][0-9]{0,2}$" }
    },
    "key_points": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/groundedPoint" }
    },
    "action_points": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/groundedPoint" }
    },
    "limitations": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_origin",
        "content_fingerprint",
        "provider_id",
        "deployment_id",
        "effective_model_id",
        "prompt_version"
      ],
      "properties": {
        "content_origin": { "const": "miniflux" },
        "content_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "provider_id": { "type": ["string", "null"], "maxLength": 128 },
        "deployment_id": { "type": ["string", "null"], "maxLength": 128 },
        "effective_model_id": { "type": ["string", "null"], "maxLength": 128 },
        "prompt_version": { "type": ["string", "null"], "maxLength": 128 }
      }
    }
  },
  "$defs": {
    "groundedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "paragraph_ids"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "paragraph_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^p[1-9][0-9]{0,2}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["complete", "partial"] } } },
      "then": {
        "properties": {
          "summary": { "minLength": 1 },
          "summary_paragraph_ids": { "minItems": 1 },
          "key_points": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "complete" } } },
      "then": { "properties": { "content_scope": { "const": "full" } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["insufficient", "unavailable"] } } },
      "then": {
        "properties": {
          "summary": { "maxLength": 0 },
          "summary_paragraph_ids": { "maxItems": 0 },
          "key_points": { "maxItems": 0 },
          "action_points": { "maxItems": 0 }
        }
      }
    }
  ]
}
