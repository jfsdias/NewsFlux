{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/tests/**/*.{js,jsx}",
    "scripts/*.js",
    "scripts/pilot-e2e/vite.config.js",
    "scripts/pilot-e2e/vite-compose.config.js",
    "scripts/pilot-e2e/playwright-compose.config.js",
    "scripts/pilot-e2e/compose.spec.js",
    "scripts/pilot-e2e/check-compose-tls.mjs",
    "e2e/**/*.spec.js",
    "e2e/reporters/*.js",
    "e2e/support/start-*.js",
    "playwright.config.js"
  ],
  "project": ["src/**/*.{js,jsx}", "scripts/**/*.{js,jsx}", "e2e/**/*.js"],
  "ignore": ["scripts/research/**"],
  "ignoreIssues": {
    "scripts/tests/pwa-chunk-recovery-focus.js": ["unresolved"]
  }
}
