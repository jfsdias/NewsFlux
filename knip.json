{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/tests/**/*.{js,jsx}",
    "scripts/*.js",
    "ops/scripts/*.js",
    "tests/aux/device-matrix/device-matrix.js",
    "tests/aux/device-matrix/load-profile.js",
    "tests/aux/pilot-e2e/vite.config.js",
    "tests/aux/pilot-e2e/vite-compose.config.js",
    "tests/aux/pilot-e2e/vite-admin.config.js",
    "tests/aux/pilot-e2e/playwright-admin.config.js",
    "tests/aux/pilot-e2e/ai-settings-admin.spec.js",
    "tests/aux/pilot-e2e/ai-settings-migration.spec.js",
    "tests/aux/pilot-e2e/playwright-compose.config.js",
    "tests/aux/pilot-e2e/compose.spec.js",
    "tests/aux/pilot-e2e/check-compose-tls.mjs",
    "tests/aux/playwright/*.config.js",
    "tests/aux/reader-ai-e2e/**/*.spec.js",
    "tests/aux/ux-reach-e2e/**/*.js",
    "tests/aux/ux-reach-01/*.spec.js",
    "tests/aux/synthetic/*.js",
    "research/personalization-pilot/**/*.js",
    "e2e/**/*.spec.js",
