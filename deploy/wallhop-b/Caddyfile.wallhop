:2000

root * /srv

header {
	X-Content-Type-Options nosniff
	Referrer-Policy strict-origin-when-cross-origin
}

# Story candidate ranking is an optional stateless sidecar. The React client is
# fail-open, so an unavailable upstream must not change the existing Home
# projection. The deployment may override this without rebuilding the app.
handle_path /api/story-candidates/* {
	reverse_proxy {$STORY_RANKER_UPSTREAM:story-ranker:8787}
}

# Only the explicitly identified TLS proxy may forward a summary request.
# The edge proxy must overwrite X-Forwarded-Proto and cannot be client-controlled.
@pilotSummary {
    path /api/ai/v1/entries/*/summary
    remote_ip {$NEWSFLUX_PILOT_TRUSTED_PROXY_IP}
    header X-Forwarded-Proto https
}
handle @pilotSummary {
    reverse_proxy summary-api:8788 {
        header_up X-Forwarded-Proto https
    }
}
# Contract v2: authenticated, read-only catalog of server-approved models. Same
# trusted-proxy and HTTPS requirements as the summary route; GET only.
@pilotModels {
    path /api/ai/v1/models
    method GET
    remote_ip {$NEWSFLUX_PILOT_TRUSTED_PROXY_IP}
    header X-Forwarded-Proto https
}
handle @pilotModels {
    reverse_proxy summary-api:8788 {
        header_up X-Forwarded-Proto https
    }
}
handle /api/ai/* {
    respond 403
}

# WallHop Reader bridge (jfsdias/NewsFlux#234, reconciled): same-origin POST only, trusted proxy,
# client auth/cookie/forwarding headers stripped. Must precede the static and SPA handlers.
@readerRecovery {
	path_regexp readerRecovery ^/api/content-fallback/reader/v1/entries/[1-9][0-9]*/recover$
	method POST
	remote_ip {$NEWSFLUX_PILOT_TRUSTED_PROXY_IP}
	header X-Forwarded-Proto https
}

handle @readerRecovery {
	handle_path /api/content-fallback/* {
		reverse_proxy content-fallback-reader:8790 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Host {host}
			header_up -Forwarded
			header_up -Authorization
			header_up -Cookie
			header_up -X-Forwarded-Client-Cert
			header_up -X-Forwarded-User
			header_up -X-Forwarded-Prefix
			header_up -X-Forwarded-Port
			header_up -X-Forwarded-Server
			header_up -X-Forwarded-SSL
			header_up -X-Real-IP
		}
	}
}

handle /api/content-fallback/* {
	respond 404
}

@staticFiles file {path} {path}/
handle @staticFiles {
	file_server
}

# Build assets are immutable references from the loaded application shell. If a
# hashed asset is absent, return a real file-server miss instead of the SPA
# document so Vite can surface the lazy-chunk recovery path.
@buildAssets path_regexp buildAssets \.(?:avif|css|eot|gif|ico|jpe?g|js|json|map|mjs|mp3|mp4|otf|pdf|png|svg|ttf|txt|wasm|webm|webmanifest|webp|woff2?|xml)$
handle @buildAssets {
	file_server
}

handle {$REACTFLUX_BASE_PATH:/}* {
	try_files {path} {path}/ {$REACTFLUX_BASE_PATH:/}index.html
	file_server
}

respond 404
