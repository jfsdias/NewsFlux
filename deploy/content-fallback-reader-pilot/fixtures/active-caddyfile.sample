:2000
	@summary path /api/summary/*
	handle @summary {
		reverse_proxy summary-api:8080
	}
	@story path /api/story-ranker/*
	handle @story {
		reverse_proxy story-ranker:8080
	}
	handle /assets/* {
		root * /srv/newsflux
		file_server
	}
	handle {$REACTFLUX_BASE_PATH:/}* {
		root * /srv/newsflux
		try_files {path} {path}/ {$REACTFLUX_BASE_PATH:/}index.html
		file_server
	}
